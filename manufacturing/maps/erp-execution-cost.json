  "cards": [
    {
      "dot": "emerald",
      "title": "三行是业务视图",
      "items": [
        "材料、资源和完工记录均关联同一 ERP 生产订单。",
        "成本明细汇入该订单核算，三行不代表三个独立成本账。"
      ]
    },
    {
      "dot": "orange",
      "title": "先确定过账边界",
      "items": [
        "线边库转移、生产耗用与成品入库须约定各自触发来源。",
        "MES 报工与 WMS 收货若对应同一入库，不得分别重复增加库存。"
      ]
    },
    {
      "dot": "rose",
      "title": "核对后再结束订单",
      "items": [
        "图中省略失败回执、质量放行、发票和期末调整路径。",
        "结算还须核对材料与资源完整性；动画不表示实际时序。",
        "模拟接口边界；同一业务只选择一个过账触发来源，失败结果进入差异队列"
      ]
    }
